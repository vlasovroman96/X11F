
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "manual-dub-build",
            "type": "shell",
            "command": "dub",
            "args": [
                "build",
                "--compiler=dmd",
                "--build=debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$dmd"]
        }
    ]
}