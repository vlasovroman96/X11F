	"version": "0.2.0",
	"configurations": [
		{
			"type": "lldb",
			"request": "launch",
			"name": "Launch",
			"program": "${workspaceFolder}/x12",
			"args": [":2"],
			"cwd": "${workspaceFolder}"
		},	
		{
			"type": "lldb",
			"request": "launch",
			"name": "Launch XOrg",
			"program": "/home/roman/xserver/build/hw/xfree86/Xorg",
			"args": [":1"],
			"cwd": "/home/roman/xserver/build/hw/xfree86"
		},		
		
		{
			"type": "code-d",
			"request": "launch",
			"dubBuild": true,
			"name": "Build & Debug DUB project",
			"cwd": "${command:dubWorkingDirectory}",
			"program": "${command:dubTarget}"
		}
	]
}