{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug x12",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/x12",
            "args": [],

            "cwd": "${workspaceFolder}",

            "stopAtEntry": false,
            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "set print pretty on",
                    "ignoreFailures": true
                },
                {
                    "description": "Do not stop on shared library events",
                    "text": "set stop-on-solib-events 0",
                    "ignoreFailures": true
                }
            ],

            "logging": {
                "engineLogging": true,
                "trace": false,
                "traceResponse": false
            }
        }
    ]
}