{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Xenia — GDB",
            "type": "cppdbg",
            "request": "launch",

            "program": "/home/roman/Xenia/Xenia",
            "args": ["-retro", "-ac"],
            "cwd": "/home/roman/Xenia",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "setupCommands": [
                {
                    "description": "Connect to persistent gdbserver",
                    "text": "target extended-remote 127.0.0.1:2345",
                    "ignoreFailures": false
                },
                {
                    "description": "Set remote executable",
                    "text": "set remote exec-file /home/roman/Xenia/Xenia",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Allow pending breakpoints",
                    "text": "set breakpoint pending on",
                    "ignoreFailures": true
                }
            ],

            "launchCompleteCommand": "exec-run",
            "stopAtEntry": false,

                "sourceFileMap": {
    "/usr/src/debug/xlibre-video-vmware/xf86-video-vmware-xlibre-xf86-video-vmware-25.0.0": "/home/roman/vmware-src/xf86-video-vmware-xlibre-xf86-video-vmware-25.0.0"
}
        }
    ]
}