	"name": "x12",
	"dependencies": {
	},
	"targetType": "executable",
	"dflags": [
		"-i",
    "-P-I/usr/include/dbus-1.0",
    "-P-I/usr/include/pixman-1",
    "-P-I/usr/lib/dbus-1.0/include",
    "-P-Isource/Xext/dri2",
    "-P-I/usr/include/libdrm",
    "-P-Isource",
    "-P-Isource/hw/xfree86/x86emu",
    "-P-Isource/externs",
	"-P-D__int128=long long",
    "-P-D__attribute__(x)=",
	"-P-D__alignof__(x)=8",
	"-P=-D__kernel_size_t=size_t",
	"-deps=/tmp/x11f.deps"
    ],
	"excludedSourceFiles": [
		"source/hw/kdrive/*",
		"source/hw/xnest/*",
		"source/hw/xquartz/*",
		"source/hw/xwin/*",
		"source/hw/vfb/*"
		
	],
	"lflags-posix-dmd": [
        "-ldbus-1",
        "-ldrm",
        "-lgbm",
        "-lpixman-1",
		"-lcrypto",
		"-lXfont2",
		"-lXau",
		"-lxshmfence",
		"-lpciaccess",
		"-lseat",
		"-lxcvt",
		"-lepoxy",
		"-lxcb",
		"-lxcb-ewmh",
		"-laudit",
		"-ludev",
		"-lhal",
		"-lGL",
		"-lXdmcp"
	],
	"preBuildCommands": [
	]
}