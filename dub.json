	"name": "x12",
	"dependencies": {
	},
	"targetType": "executable",
	"dflags": [
        "-verrors=5",
		"-P-I/usr/include/dbus-1.0",
		"-P-I/usr/include/pixman-1",
		"-P-I/usr/lib/dbus-1.0/include",
		"-P-Isource/Xext/dri2",
		"-P=-I/usr/include/libdrm",
		"-P=-I/usr/include/X11/fonts/",
		"-P-Isource",
		"-P-Isource/hw/xfree86/x86emu",
		"-P-I/usr/include/linux",
		"-P=-D__int128=long long",
        "-P=-D__attribute__(x)=",
		"-P=-D_STRUCT_TIMEVAL",
        "-P=-D_LINUX_TIME_H",
		"-P=-D__alignof__=sizeof",
		"-P-Isource/externs"
    ],
	"importPaths": [
		"source"
	]
}